{
  "name": "unreal-code-cleanup",
  "displayName": "unreal code cleanup",
  "publisher": "majestic",
  "repository": {
    "type": "git",
    "url": "https://github.com/majestic-world/unreal-clean-up.git"
  },
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "unreal-code-cleanup.clean",
        "title": "Unreal Cleanup"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "unreal-code-cleanup.clean",
          "group": "modification"
        }
      ],
      "explorer/context": [
        {
          "command": "unreal-code-cleanup.clean",
          "group": "modification"
        }
      ]
    },
    "keybindings": [
      {
        "command": "unreal-code-cleanup.clean",
        "key": ""
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
